# UrbanEye AI — Backend Environment Variables
# Copy this file to .env and fill in the values before running locally.
# NEVER commit .env to git.

# ── Database ──────────────────────────────────────────────────────────────────
# Local SQLite (default — no change needed for local dev):
# DATABASE_URL=sqlite:///./data/traffic.db
# Render/Railway Postgres (paste the Internal Database URL from the dashboard):
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local dev: leave blank or set to http://localhost:3000
# Production: set to your Vercel deployment URL
FRONTEND_URL=https://your-app.vercel.app

# ── Model Provider ────────────────────────────────────────────────────────────
# "local"       → use .pt files from backend/models/ (default)
# "huggingface" → call HF Inference API for detection (OCR always local)
MODEL_PROVIDER=local

# ── Hugging Face (only needed when MODEL_PROVIDER=huggingface) ───────────────
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_VEHICLE_MODEL_URL=https://api-inference.huggingface.co/models/your-org/vehicle-detector
HF_PLATE_MODEL_URL=https://api-inference.huggingface.co/models/your-org/plate-detector

# ── OCR Engine ────────────────────────────────────────────────────────────────
# "paddleocr"  → fine-tuned PaddleOCR (requires local model files)
# "easyocr"    → generic EasyOCR (no training needed, lower accuracy on Indian plates)
OCR_ENGINE=paddleocr
