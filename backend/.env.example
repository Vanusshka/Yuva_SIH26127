# UrbanEye AI — Backend Environment Variables
# Copy this file to .env and fill in values for local development.
# NEVER commit .env to git.

# ── Database ──────────────────────────────────────────────────────────────────
# Local SQLite (default — no change needed for local dev):
# DATABASE_URL is not needed locally — SQLite is used automatically.
#
# Render PostgreSQL (paste the Internal Database URL from Render dashboard):
# DATABASE_URL=postgresql://user:password@host:5432/urbaneye

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Leave blank for local dev (localhost:3000/5173 are always allowed).
# Production: set to your Vercel deployment URL.
FRONTEND_URL=https://your-app.vercel.app

# ── Model Provider ────────────────────────────────────────────────────────────
# "local" → use .pt files from backend/models/ (default, always use this)
MODEL_PROVIDER=local

# ── OCR Engine ────────────────────────────────────────────────────────────────
# "paddleocr"  → fine-tuned PaddleOCR SVTR_LCNet (requires model files below)
# "easyocr"    → generic EasyOCR (no training needed, lower accuracy)
OCR_ENGINE=paddleocr

# ── Model file download URLs (Render build only) ──────────────────────────────
# These are only needed when deploying to Render.
# Set them in the Render dashboard Environment Variables section.
# Upload your model files to any publicly accessible URL:
#   - GitHub Releases (recommended — free, fast)
#   - Google Drive (use direct download URL format)
#   - AWS S3 pre-signed URL
#   - Any static file host
#
# MODEL_VEHICLE_URL=https://github.com/your-org/urbaneye-models/releases/download/v1/best.pt
# MODEL_PLATE_URL=https://github.com/your-org/urbaneye-models/releases/download/v1/plate_detector_best_fast.pt
# MODEL_PADDLE_URL=https://github.com/your-org/urbaneye-models/releases/download/v1/plates_inference_model_final.zip
# MODEL_PADDLEINFER_URL=https://github.com/your-org/urbaneye-models/releases/download/v1/paddleocr_infer.zip
