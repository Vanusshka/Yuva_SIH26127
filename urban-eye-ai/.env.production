# UrbanEye AI — Vercel Production Environment
# Set NEXT_PUBLIC_API_URL to your deployed backend URL in Vercel dashboard
# If no backend is deployed, DEMO_MODE=true shows placeholder data with clear labels

# Replace with your actual backend URL (Railway / Render / Cloud Run)
NEXT_PUBLIC_API_URL=https://your-backend-url.com

# Keep true until a real backend is deployed on a public URL
NEXT_PUBLIC_DEMO_MODE=true
